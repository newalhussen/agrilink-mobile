<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgriLink" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/agri_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AgriLink.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/agri_sage_800</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.AgriLink</item>
    </style>
</resources>
